# ============================================================================
# labs-management-system 环境变量模板
#
# 用法：cp .env.example .env 然后**逐项修改**，特别是管理员密码。
# .env 已被 .gitignore 排除，绝不要提交。
#
# 注意：docker compose 会把这个文件同时用于两处：
#   1) 作为 compose 文件里的变量插值来源（${APP_DOMAIN} 等）；
#   2) 通过 app 服务的 env_file 注入应用容器。
# web（Caddy）服务只显式接收 APP_DOMAIN / ACME_EMAIL，不再整份注入，
# 避免管理员密码出现在不需要它的容器里。
# ============================================================================

# 已解析到本服务器的公网域名。Caddy 用它申请并自动续期 TLS 证书。
APP_DOMAIN=lab.example.com
# Let's Encrypt 通知邮箱。
ACME_EMAIL=admin@example.com

# 仅在数据库中不存在任何管理员时用于创建首个管理员。
# 要求：至少 12 位，且不能是示例占位值 —— 否则应用会拒绝启动（LabApplication.requireNonPlaceholderPassword）。
# 生成建议：openssl rand -base64 24
APP_BOOTSTRAP_ADMIN_STUDENT_NO=admin
APP_BOOTSTRAP_ADMIN_NAME=系统管理员
APP_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password

# 单实例 SQLite 的可选调优。
DB_POOL_SIZE=4
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# 会话空闲超时（Spring Duration 格式，如 8h、30m）。默认 8h。
SESSION_TIMEOUT=8h
