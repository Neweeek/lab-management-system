# A public domain that already resolves to this server. Caddy obtains and renews TLS certificates.
APP_DOMAIN=lab.example.com
ACME_EMAIL=admin@example.com

# Created only when the database has no administrator. Use a unique, long password.
APP_BOOTSTRAP_ADMIN_STUDENT_NO=admin
APP_BOOTSTRAP_ADMIN_NAME=系统管理员
APP_BOOTSTRAP_ADMIN_PASSWORD=change-this-to-a-long-unique-password

# Optional tuning for a single SQLite application instance.
DB_POOL_SIZE=4
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
